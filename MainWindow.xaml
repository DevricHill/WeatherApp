<Window x:Class="WeatherApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:WeatherApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="1000" Width="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>



        <wv2:WebView2 Grid.Column="0" Margin="20" Source="https://www.google.com/maps"/>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TabControl Grid.Row="0" TabStripPlacement="Top" Margin="10">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Padding" Value="30,10"/>
                        <Setter Property="MinHeight" Value="20"/>
                    </Style>
                </TabControl.Resources>
                
                
                <TabItem Header="{Binding LocationName}">
                    <ListView ItemsSource="{Binding WeatherValues}" Grid.Row="0" Margin="10">
                        <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Property" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                <GridViewColumn Header="Value" Width="200" DisplayMemberBinding="{Binding Value}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </TabItem>

                <TabItem Header="More">
                    
                </TabItem>
                
            </TabControl>

            <StackPanel Grid.Row="1" Margin="10">
                
                <WrapPanel>
                    <Label Content="Weather Api Key"/>
                    <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5"/>

                    <Label Content="Zip Code"/>
                    <TextBox Text="{Binding ZipCode, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="5"/>

                    <Button Content="Submit" Command="{Binding LoadWeatherCommand}" 
                            Width="80" Height="20" Margin="10" Background="AliceBlue"/>

                    </WrapPanel>
            
                <TextBlock Text="{Binding StatusText}" Margin="5,0"/>
            </StackPanel>
            
        </Grid>

    </Grid>
</Window>
